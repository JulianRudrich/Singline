# Editor settings for every file in the repository. rustfmt and the Svelte
# checks have the last word on formatting.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,py}]
indent_size = 4

# In Markdown, two spaces at the end of a line break it.
[*.md]
trim_trailing_whitespace = false
